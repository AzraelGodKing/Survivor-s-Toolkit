<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that needs no WinForms (finding the game, reading mods, modlists, problems, the log), so it can be tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SurvivorsToolkit.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keeps the server passwords in the settings encrypted for the Windows user (DPAPI). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SurvivorsToolkit.Tests" />
  </ItemGroup>
</Project>
